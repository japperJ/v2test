# Database
DATABASE_URL=postgresql://geofence:geofence_dev_pass@localhost:5432/geofence

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=change_this_to_a_random_secret_at_least_32_chars

# MaxMind GeoIP databases
MAXMIND_CITY_DB_PATH=./data/maxmind/GeoLite2-City.mmdb
MAXMIND_ANONYMOUSIP_DB_PATH=./data/maxmind/GeoIP2-Anonymous-IP.mmdb

# S3 / MinIO
# Canonical names used by the backend (AWS SDK standard)
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET_NAME=geofence-artifacts
# Public origin for MinIO presigned URL CSP allowlist (optional in dev)
# MINIO_PUBLIC_ORIGIN=http://localhost:9000

# App
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
TRUST_PROXY=false
CORS_ORIGIN=http://localhost:5173
