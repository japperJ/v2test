{
  "name": "geofence-backend",
  "version": "0.1.0",
  "description": "Geo-fenced multi-site webserver backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:create": "node -e \"const fs=require('fs');const ts=new Date().toISOString().replace(/[^0-9]/g,'').slice(0,14);const n=process.argv[2]||'migration';const files=fs.readdirSync('migrations').filter(f=>f.endsWith('.sql'));const next=String(files.length+1).padStart(3,'0');const name=`${next}_${n}.sql`;fs.writeFileSync('migrations/'+name,'-- Migration: '+name+'\\n');console.log('Created',name);\""
  },
  "dependencies": {
    "fastify": "^4.28.0",
    "@fastify/jwt": "^8.0.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.1.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/cookie": "^9.3.1",
    "pg": "^8.11.3",
    "node-pg-migrate": "^7.2.1",
    "maxmind": "^4.3.15",
    "ipaddr.js": "^2.2.0",
    "lru-cache": "^10.2.2",
    "ioredis": "^5.3.2",
    "node-cron": "^3.0.3",
    "zod": "^3.22.4",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "@aws-sdk/client-s3": "^3.521.0",
    "@aws-sdk/s3-request-presigner": "^3.521.0"
  },
  "devDependencies": {
    "typescript": "^5.4.2",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.11.2",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.7.1",
    "vitest": "^1.3.1",
    "@vitest/coverage-v8": "^1.3.1",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "prettier": "^3.2.5"
  }
}
